ENV=dev
DEBUG=True
DEBUG_SQL=False

MINIAPP_URL="https://example.com"  # must be https

# Required
SECRET_KEY=""  # openssl rand -hex 64 | xxd -r -p | base64
SECRET_KEY_VERSION=1  # bump when rotating SECRET_KEY; old rows keep the old version byte
DATABASE_URL="postgresql+asyncpg://user:password123@localhost:5443/db"
REDIS_URL="redis://localhost:6379"
TGBOT_NAME="<not-real-telegram-bot-username>"  # bot username without @
TGBOT_TOKEN="<not-real-telegram-token>"
OPENAI_API_KEY="<not-real-openai-api-key>"
# Required -- Storage
STORAGE_URL="http://localhost:9000"
STORAGE_BUCKET=gramstack
STORAGE_ACCESS_KEY=""  # http://localhost:9001 >  Access Keys > Create access key
STORAGE_SECRET_KEY=""  # http://localhost:9001 > Access Keys > Create access key

# Optional -- Public storage (a bucket served without signed urls)
#PUBLIC_STORAGE_URL="https://cdn.example.com"

# Optional
TGBOT_SETUP_COMMANDS=False  # should we set up initial commands for bot, helps to avoid a flood limit control error, when restarting bot too often
TGBOT_REQUIRES_INVITE=False  # requires invites to signup, also enables the admin /generate_invite* commands
TGBOT_LANG_COMMAND_ENABLED=False  # adds the /lang command, so a user can override the language detected from telegram
TGBOT_WEBHOOK_URL=""  # must be https
TGBOT_WEBHOOK_SECRET_TOKEN=""  # required for setting up webhook
CORS_ALLOW_ORIGINS=["*"]
LOGFIRE_TOKEN="<not-real-logfire-token>"
LOGFIRE_FASTAPI=False  # send fastapi request traces to logfire
LOGFIRE_SQLALCHEMY=False  # send sql query traces to logfire
POSTHOG_API_KEY=""  # optional, tracking disabled when empty
POSTHOG_HOST=""  # e.g. https://eu.i.posthog.com
